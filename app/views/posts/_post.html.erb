<div class="box py-3 mb-3">
  <article class="media mb-0">
    <div class="media-content">
      <div class="level mb-1">
        <div class="level-left">
          <div class="level-item">
            <strong>
              <%= link_to post.title, collection_post_path(post.collection, post), class: "has-text-info-light" %>
            </strong>
          </div>
          <div class="level-item pl-6">
            <small class="has-text-grey">
              Posted by <%= post.user.name || post.user.email %> 
              <%= time_ago_in_words(post.created_at) %> ago
            </small>
          </div>
        </div>
        <div class="level-right">
          <div class="buttons are-small">
            <%= link_to "View", collection_post_path(post.collection, post), class: "button is-link is-light" %>
            <% if user_signed_in? %>
              <% if post.user == current_user %>
                <%= link_to "Edit", edit_collection_post_path(post.collection, post), class: "button is-info is-light" %>
              <% end %>
              
              <% if post.user == current_user || post.collection.moderator?(current_user) %>
                <%= button_to "Delete", collection_post_path(post.collection, post), 
                    method: :delete, 
                    class: "button is-danger is-light",
                    form: { class: 'd-inline' },
                    data: { 
                      turbo_confirm: "Are you sure you want to delete this post?#{' (Moderator Action)' if post.collection.moderator?(current_user)}" 
                    } %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      <div class="content is-small has-text-grey-light">
        <%= truncate(post.content, length: 200) %>
      </div>
    </div>
  </article>
</div>

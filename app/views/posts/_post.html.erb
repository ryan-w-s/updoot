<div class="card mb-3">
  <div class="card-body">
    <h5 class="card-title"><%= link_to post.title, collection_post_path(post.collection, post) %></h5>
    <h6 class="card-subtitle mb-2 text-muted">
      Posted by <%= post.user.name || post.user.email %> 
      <%= time_ago_in_words(post.created_at) %> ago
    </h6>
    <p class="card-text"><%= truncate(post.content, length: 300) %></p>
    
    <% if user_signed_in? && post.user == current_user %>
      <div class="card-actions">
        <%= link_to "Edit", edit_collection_post_path(post.collection, post), class: "btn btn-sm btn-outline-secondary" %>
        <%= button_to "Delete", collection_post_path(post.collection, post), method: :delete, class: "btn btn-sm btn-outline-danger", form: { style: 'display: inline-block' }, data: { turbo_confirm: "Are you sure?" } %>
      </div>
    <% end %>
  </div>
</div>

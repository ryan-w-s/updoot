<div class="container">
  <p style="color: green"><%= notice %></p>

  <div class="card">
    <div class="card-body">
      <h1 class="card-title"><%= @post.title %></h1>
      <h6 class="card-subtitle mb-2 text-muted">
        Posted by <%= @post.user.name || @post.user.email %> 
        <%= time_ago_in_words(@post.created_at) %> ago
      </h6>
      <div class="card-text mt-4">
        <%= simple_format @post.content %>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <% if user_signed_in? && @post.user == current_user %>
      <%= link_to "Edit Post", edit_collection_post_path(@collection, @post), class: "btn btn-secondary" %>
      <%= button_to "Delete Post", collection_post_path(@collection, @post), method: :delete, 
          class: "btn btn-danger", form: { style: 'display: inline-block' }, 
          data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
    <%= link_to "Back to Collection", collection_path(@collection), class: "btn btn-link" %>
  </div>
</div>

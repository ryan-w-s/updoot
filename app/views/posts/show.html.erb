<section class="section">
  <div class="container">
    <% if notice %>
      <div class="notification is-success">
        <%= notice %>
      </div>
    <% end %>

    <div class="box">
      <h1 class="title"><%= @post.title %></h1>
      <p class="subtitle is-6">
        Posted by <%= @post.user.name || @post.user.email %> 
        <%= time_ago_in_words(@post.created_at) %> ago
        in <%= link_to @post.collection.name, collection_path(@post.collection), class: "has-text-info" %>
      </p>
      <div class="tags">
        <span class="tag is-success">
          <span class="icon">
            <i class="fas fa-arrow-up"></i>
          </span>
          <span><%= @post.updoot_count %></span>
        </span>
        <span class="tag is-danger">
          <span class="icon">
            <i class="fas fa-arrow-down"></i>
          </span>
          <span><%= @post.downdoot_count %></span>
        </span>
        <span class="tag is-info">
          <span class="icon">
            <i class="fas fa-chart-line"></i>
          </span>
          <span>Score: <%= @post.doot_total %></span>
        </span>
      </div>
      <div class="content">
        <%= simple_format @post.content %>
      </div>
    </div>

    <div class="field is-grouped mt-4">
      <% if user_signed_in? && @post.user == current_user %>
        <div class="control">
          <%= link_to "Edit Post", edit_collection_post_path(@collection, @post), class: "button is-info" %>
        </div>
        <div class="control">
          <%= button_to "Delete Post", collection_post_path(@collection, @post), 
              method: :delete, 
              class: "button is-danger",
              data: { turbo_confirm: "Are you sure?" } %>
        </div>
      <% end %>
      <div class="control">
        <%= link_to "Back to Collection", collection_path(@collection), class: "button is-light" %>
      </div>
    </div>
  </div>
</section>

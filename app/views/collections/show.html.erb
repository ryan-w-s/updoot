<section class="section">
  <div class="container">
    <% if notice %>
      <div class="notification is-success">
        <%= notice %>
      </div>
    <% end %>

    <%= render @collection %>

    <div class="field is-grouped mb-5">
      <% if user_signed_in? %>
        <div class="control">
          <%= link_to "New Post", new_collection_post_path(@collection), class: "button is-primary" %>
        </div>

        <% if current_user.watching?(@collection) %>
          <div class="control">
            <%= button_to "Unwatch", collection_watcher_path(@collection), 
                method: :delete, 
                class: "button is-warning" %>
          </div>
        <% else %>
          <div class="control">
            <%= button_to "Watch", collection_watcher_path(@collection), 
                method: :post, 
                class: "button is-info" %>
          </div>
        <% end %>
      <% end %>
      
      <% if user_signed_in? && @collection.moderator?(current_user) %>
        <div class="control">
          <%= link_to "Edit Collection", edit_collection_path(@collection), class: "button is-info" %>
        </div>
        <div class="control">
          <%= button_to "Delete Collection", @collection, method: :delete, 
              class: "button is-danger",
              data: { turbo_confirm: "Are you sure?" } %>
        </div>
      <% end %>
      
      <div class="control">
        <%= link_to "Back to Collections", collections_path, class: "button is-light" %>
      </div>
    </div>

    <div class="posts-container">
      <h2 class="title is-4">Posts</h2>
      <% if @collection.posts.any? %>
        <%= render @collection.posts.order(created_at: :desc) %>
      <% else %>
        <div class="notification is-info is-light">
          No posts yet. Be the first to create one!
        </div>
      <% end %>
    </div>
  </div>
</section>

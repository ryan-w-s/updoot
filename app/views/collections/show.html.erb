<p style="color: green"><%= notice %></p>

<div class="container">
  <%= render @collection %>

  <div class="mb-4">
    <% if user_signed_in? %>
      <%= link_to "New Post", new_collection_post_path(@collection), class: "btn btn-primary" %>
    <% end %>
    
    <% if user_signed_in? && @collection.moderator?(current_user) %>
      <%= link_to "Edit Collection", edit_collection_path(@collection), class: "btn btn-secondary" %>
      <%= button_to "Delete Collection", @collection, method: :delete, class: "btn btn-danger", form: { style: 'display: inline-block' }, data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
    
    <%= link_to "Back to Collections", collections_path, class: "btn btn-link" %>
  </div>

  <div class="posts-container">
    <h2>Posts</h2>
    <%= render @collection.posts.order(created_at: :desc) %>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-two-thirds">
        <div class="box">
          <h1 class="title is-2 has-text-centered">Edit Collection</h1>

          <div class="columns">
            <div class="column">
              <h2 class="title is-4">Collection Details</h2>
              <%= render "form", collection: @collection %>
            </div>

            <div class="column">
              <h2 class="title is-4">Manage Moderators</h2>
              <div class="box has-background-light">
                <h3 class="subtitle mb-3">Current Moderators</h3>
                <% if @collection.mods.any? %>
                  <div class="list">
                    <% @collection.mods.each do |mod| %>
                      <div class="list-item">
                        <div class="level is-mobile">
                          <div class="level-left">
                            <div class="level-item">
                              <span class="icon-text">
                                <span class="icon">
                                  <i class="fas fa-user-shield"></i>
                                </span>
                                <span><%= mod.name || mod.email %></span>
                              </span>
                            </div>
                          </div>
                          <div class="level-right">
                            <% if @collection.mods.count > 1 %>
                              <%= button_to collection_moderator_path(@collection, mod), 
                                  method: :delete,
                                  class: "button is-small is-danger is-light",
                                  form: { class: 'd-inline' },
                                  data: { turbo_confirm: "Are you sure you want to remove this moderator?" } do %>
                                <span class="icon">
                                  <i class="fas fa-times"></i>
                                </span>
                              <% end %>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <p class="has-text-grey">No moderators yet.</p>
                <% end %>

                <div class="mt-4">
                  <h3 class="subtitle mb-3">Add Moderator</h3>
                  <%= form_with(url: collection_moderators_path(@collection), local: true, class: "is-flex") do |f| %>
                    <div class="field has-addons">
                      <div class="control is-expanded">
                        <%= f.text_field :user_email, class: "input", placeholder: "Enter user email" %>
                      </div>
                      <div class="control">
                        <%= f.submit "Add", class: "button is-info" %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div class="has-text-centered mt-5">
            <%= link_to "Back to Collection", @collection, class: "button is-light" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

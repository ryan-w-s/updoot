<section class="section">
  <div class="container">
    <% if notice %>
      <div class="notification is-success">
        <%= notice %>
      </div>
    <% end %>

    <div class="level">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">Collections</h1>
        </div>
      </div>
      <div class="level-right">
        <div class="level-item">
          <% if user_signed_in? %>
            <%= link_to "New Collection", new_collection_path, class: "button is-primary" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="collections-container">
      <% if @collections.any? %>
        <%= render @collections %>
      <% else %>
        <div class="notification is-info is-light">
          No collections yet. <%= link_to "Create the first one!", new_collection_path if user_signed_in? %>
        </div>
      <% end %>
    </div>
  </div>
</section>

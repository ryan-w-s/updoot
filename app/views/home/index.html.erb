<section class="section">
  <div class="container">
    <div class="level">
      <div class="level-left">
        <div class="level-item">
          <h1 class="title">
            <% if user_signed_in? %>
              Your Feed
            <% else %>
              Popular Posts
            <% end %>
          </h1>
        </div>
      </div>
      <% if !user_signed_in? %>
        <div class="level-right">
          <div class="level-item">
            <div class="notification is-info is-light mb-0">
              <span class="icon-text">
                <span class="icon">
                  <i class="fas fa-info-circle"></i>
                </span>
                <span>
                  <strong>Sign up</strong> to customize your feed with collections you watch!
                </span>
              </span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="posts-container">
      <% if @posts.any? %>
        <%= render partial: "posts/post", collection: @posts %>
        
        <div class="has-text-centered mt-6">
          <%= paginate @posts, window: 2 %>
        </div>
      <% else %>
        <div class="notification is-info is-light">
          <% if user_signed_in? %>
            No posts yet from your watched collections. 
            <%= link_to "Browse collections", collections_path %> to find some to watch!
          <% else %>
            No popular posts from the past week.
            <%= link_to "Browse all collections", collections_path %> to see more!
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
